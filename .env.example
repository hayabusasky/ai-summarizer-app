# Claude API (summarization / classification)
ANTHROPIC_API_KEY=

# Which SNS to post to: "x", "threads", or "both"
POST_TARGETS=both

# X (Twitter) API v2 - OAuth 1.0a user context, needs "elevated"/paid tier with tweet.write
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Threads API (Meta) - long-lived user access token + the Threads user id
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Max number of articles to process per run (cost control)
MAX_ARTICLES_PER_RUN=3

# Set to "true" to run the full pipeline without actually posting (prints to console instead)
DRY_RUN=false

# Instagram Reels (Instagram Graph API) - business/creator account linked to a Facebook Page
IG_USER_ID=
IG_ACCESS_TOKEN=
# "graph.facebook.com" (Facebook Login) or "graph.instagram.com" (Instagram Login)
IG_GRAPH_HOST=graph.facebook.com
